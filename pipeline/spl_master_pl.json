{
	"name": "spl_master_pl",
	"properties": {
		"activities": [
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.files_list",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Execute Pipeline1",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "source_to_parquet_pl",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"source_container": "source-files",
									"source_folder": "spl",
									"source_file": {
										"value": "@variables('current_file')",
										"type": "Expression"
									},
									"target_container": "output",
									"target_folder": "parquet",
									"target_file": {
										"value": "@concat(\n  'spl_fall2026_',\n  substring(replace(replace(variables('current_file'),'Seattle_Pet_Licenses_',''),'.csv',''),0,4),\n  '_',\n  substring(replace(replace(variables('current_file'),'Seattle_Pet_Licenses_',''),'.csv',''),4,2),\n  '_',\n  substring(replace(replace(variables('current_file'),'Seattle_Pet_Licenses_',''),'.csv',''),6,2),\n  '.parquet'\n)",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Set variable1",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "current_file",
								"value": {
									"value": "@item()",
									"type": "Expression"
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"files_list": {
				"type": "array",
				"defaultValue": [
					"Seattle_Pet_Licenses_20260915 (1).csv",
					"Seattle_Pet_Licenses_20261001.csv",
					"Seattle_Pet_Licenses_20261015.csv"
				]
			}
		},
		"variables": {
			"current_file": {
				"type": "String"
			}
		},
		"annotations": []
	}
}