{
	"name": "spl_master_pl",
	"properties": {
		"activities": [
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.files_list",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Execute Pipeline1",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [
								{
									"name": ""
								}
							],
							"typeProperties": {
								"pipeline": {
									"referenceName": "source_to_parquet_pl",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"source_container": "source-files",
									"source_folder": "spl",
									"source_file": "@item()",
									"target_container": "output",
									"target_folder": "/",
									"target_file": "@concat(replace(item(),'.csv',''),'.parquet')"
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"files_list": {
				"type": "array",
				"defaultValue": [
					"Seattle_Pet_Licenses_20260915 (1).csv",
					"Seattle_Pet_Licenses_20261001.csv",
					"Seattle_Pet_Licenses_20261015.csv"
				]
			}
		},
		"annotations": []
	}
}